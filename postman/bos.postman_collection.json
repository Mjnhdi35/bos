          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 400', function () { pm.response.to.have.status(400); });", "pm.test('error=invalid_definition', function () { pm.expect(pm.response.json().error).to.eql('invalid_definition'); });"] } }]
