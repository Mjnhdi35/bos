{
  "info": {
    "name": "BOS API (Phase 6 generic)",
    "_postman_id": "bos-api-collection-v2",
    "description": "Generic API + auth end-to-end tests for BOS. Requires a running server with the chosen DATABASE backend reachable (default baseUrl http://localhost:3000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', function () { pm.response.to.have.status(200); });", "pm.test('body status=ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"] } }]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Set fresh test credentials",
          "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["const ts = Date.now();", "pm.environment.set('test_email', 'bos+' + ts + '@example.com');"] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } }
        },
        {
          "name": "POST /auth/register",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{test_email}}\",\"password\":\"Sup3rSecret!\"}" }, "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 201', function () { pm.response.to.have.status(201); });", "var b = pm.response.json();", "pm.environment.set('access_token', b.access_token);", "pm.test('HttpOnly refresh cookie', function () { pm.expect(pm.response.headers.get('Set-Cookie')).to.contain('refresh_token='); pm.expect(pm.response.headers.get('Set-Cookie')).to.contain('HttpOnly'); });"] } }]
        },
        {
          "name": "POST /auth/login",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{test_email}}\",\"password\":\"Sup3rSecret!\"}" }, "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "GET /auth/me (guard)",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', function () { pm.response.to.have.status(200); });", "pm.test('email matches', function () { pm.expect(pm.response.json().email).to.eql(pm.environment.get('test_email')); });"] } }]
        },
        {
          "name": "GET /auth/me without bearer -> 401",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 401', function () { pm.response.to.have.status(401); });"] } }]
        }
      ]
    },
    {
      "name": "Generic API",
      "item": [
        {
          "name": "GET /api/applications",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/applications", "host": ["{{baseUrl}}"], "path": ["api", "applications"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "GET /api/applications/landing_page_backend/entities/LandingPage/definition",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/applications/landing_page_backend/entities/LandingPage/definition", "host": ["{{baseUrl}}"], "path": ["api", "applications", "landing_page_backend", "entities", "LandingPage", "definition"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "POST LandingPage (capture id)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"title\":\"Welcome\",\"slug\":\"welcome\",\"content\":\"Hello\",\"published\":false}" }, "url": { "raw": "{{baseUrl}}/api/applications/landing_page_backend/entities/LandingPage", "host": ["{{baseUrl}}"], "path": ["api", "applications", "landing_page_backend", "entities", "LandingPage"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 201', function () { pm.response.to.have.status(201); });", "pm.environment.set('landing_id', pm.response.json().data.id);"] } }]
        },
        {
          "name": "POST .../transition/submit (workflow)",
          "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/applications/landing_page_backend/entities/LandingPage/{{landing_id}}/transition/submit", "host": ["{{baseUrl}}"], "path": ["api", "applications", "landing_page_backend", "entities", "LandingPage", "{{landing_id}}", "transition", "submit"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "POST .../transition/publish (workflow)",
          "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/applications/landing_page_backend/entities/LandingPage/{{landing_id}}/transition/publish", "host": ["{{baseUrl}}"], "path": ["api", "applications", "landing_page_backend", "entities", "LandingPage", "{{landing_id}}", "transition", "publish"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "GET .../audit",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/applications/landing_page_backend/entities/LandingPage/{{landing_id}}/audit", "host": ["{{baseUrl}}"], "path": ["api", "applications", "landing_page_backend", "entities", "LandingPage", "{{landing_id}}", "audit"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "POST _query (URL filter)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/applications/landing_page_backend/entities/LandingPage?filter[title_eq]=Welcome", "host": ["{{baseUrl}}"], "path": ["api", "applications", "landing_page_backend", "entities", "LandingPage"], "query": [{ "key": "filter[title_eq]", "value": "Welcome" }] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', function () { pm.response.to.have.status(200); });"] } }]
        }
      ]
    }
  ]
}