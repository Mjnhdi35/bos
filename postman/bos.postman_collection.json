        {
          "name": "Set fresh user email",
          "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.environment.set('users_email', 'users+' + Date.now() + '@example.com');"] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } }
        },
        {
          "name": "POST /users (happy path)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{users_email}}\",\"password\":\"correcthorse\"}" }, "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 201', function () { pm.response.to.have.status(201); });", "var b = pm.response.json();", "pm.test('id is uuid', function () { pm.expect(b.id).to.match(/^[0-9a-f-]{36}$/); });", "pm.test('email matches', function () { pm.expect(b.email).to.eql(pm.environment.get('users_email')); });", "pm.test('createdAt present', function () { pm.expect(b.createdAt).to.be.a('string'); });", "pm.test('updatedAt present', function () { pm.expect(b.updatedAt).to.be.a('string'); });", "pm.test('no password_hash', function () { pm.expect(b.password_hash).to.be.undefined; });", "pm.test('no password', function () { pm.expect(b.password).to.be.undefined; });"] } }]
        },
        {
          "name": "POST /users duplicate -> 409",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{users_email}}\",\"password\":\"different1\"}" }, "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 409', function () { pm.response.to.have.status(409); });", "pm.test('error=email_taken', function () { pm.expect(pm.response.json().error).to.eql('email_taken'); });"] } }]
        },
        {
          "name": "POST /users invalid email -> 400",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"not-an-email\",\"password\":\"correcthorse\"}" }, "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 400', function () { pm.response.to.have.status(400); });", "pm.test('error=invalid_request', function () { pm.expect(pm.response.json().error).to.eql('invalid_request'); });"] } }]
        },
        {
          "name": "POST /users normalize email -> 201",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"  MIXED.{{$randomInt}}@EXAMPLE.com  \",\"password\":\"correcthorse\"}" }, "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 201', function () { pm.response.to.have.status(201); });", "pm.test('email is lowercased + trimmed', function () { var b = pm.response.json(); pm.expect(b.email).to.match(/^mixed\\.\\d+@example\\.com$/); });"] } }]
        }
      ]
    },    {
