{
  "info": {
    "name": "BOS API",
    "_postman_id": "bos-api-collection-v1",
    "description": "End-to-end HTTP tests for BOS API. Requires a running server with Postgres reachable (default baseUrl http://localhost:3000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', function () { pm.response.to.have.status(200); });", "pm.test('body status=ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"] } }]
        },
        {
          "name": "GET /health/db",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health/db", "host": ["{{baseUrl}}"], "path": ["health", "db"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', function () { pm.response.to.have.status(200); });", "pm.test('database connected', function () { pm.expect(pm.response.json().database).to.eql('connected'); });"] } }]
        }
      ]
    },    {
      "name": "Auth",
      "item": [
        {
          "name": "Set fresh test credentials",
          "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["const ts = Date.now();", "pm.environment.set('test_email', 'bos+' + ts + '@example.com');", "pm.environment.set('other_email', 'other+' + ts + '@example.com');"] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } }
        },
        {
          "name": "POST /auth/register (capture access token)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{test_email}}\",\"password\":\"correcthorse\"}" }, "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 201', function () { pm.response.to.have.status(201); });", "var b = pm.response.json();", "pm.test('access_token is JWT', function () { pm.expect(b.access_token).to.match(/^eyJ/); });", "pm.test('refresh_token not exposed in body', function () { pm.expect(b.refresh_token).to.be.undefined; });", "pm.test('token_type Bearer', function () { pm.expect(b.token_type).to.eql('Bearer'); });", "pm.test('expires_in > 0', function () { pm.expect(b.expires_in).to.be.greaterThan(0); });", "pm.environment.set('access_token', b.access_token);", "pm.test('HttpOnly refresh cookie', function () { pm.expect(pm.response.headers.get('Set-Cookie')).to.contain('refresh_token='); pm.expect(pm.response.headers.get('Set-Cookie')).to.contain('HttpOnly'); });"] } }]
        },
        {
          "name": "POST /auth/register duplicate -> 409",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{test_email}}\",\"password\":\"another1\"}" }, "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 409', function () { pm.response.to.have.status(409); });", "pm.test('error=email_taken', function () { pm.expect(pm.response.json().error).to.eql('email_taken'); });"] } }]
        },
        {
          "name": "POST /auth/register invalid email -> 400",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"not-an-email\",\"password\":\"correcthorse\"}" }, "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 400', function () { pm.response.to.have.status(400); });", "pm.test('error=invalid_request', function () { pm.expect(pm.response.json().error).to.eql('invalid_request'); });"] } }]
        },
        {
          "name": "POST /auth/register short password -> 400",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{other_email}}\",\"password\":\"x\"}" }, "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 400', function () { pm.response.to.have.status(400); });", "pm.test('error=invalid_request', function () { pm.expect(pm.response.json().error).to.eql('invalid_request'); });", "pm.test('no password leak in body', function () { pm.expect(JSON.stringify(pm.response.json())).not.to.contain('x'); });"] } }]
        },        {
          "name": "POST /auth/login (capture access token)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{test_email}}\",\"password\":\"correcthorse\"}" }, "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', function () { pm.response.to.have.status(200); });", "var b = pm.response.json();", "pm.test('has access_token', function () { pm.expect(b.access_token).to.match(/^eyJ/); });", "pm.test('refresh_token not exposed in body', function () { pm.expect(b.refresh_token).to.be.undefined; });", "pm.environment.set('access_token', b.access_token);", "pm.test('HttpOnly refresh cookie', function () { pm.expect(pm.response.headers.get('Set-Cookie')).to.contain('refresh_token='); pm.expect(pm.response.headers.get('Set-Cookie')).to.contain('HttpOnly'); });"] } }]
        },
        {
          "name": "POST /auth/login wrong password -> 401",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{test_email}}\",\"password\":\"wrong-password\"}" }, "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 401', function () { pm.response.to.have.status(401); });", "pm.test('error=invalid_credentials', function () { pm.expect(pm.response.json().error).to.eql('invalid_credentials'); });"] } }]
        },
        {
          "name": "POST /auth/login unknown email -> 401 (no leak)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"ghost+{{$randomInt}}@example.com\",\"password\":\"correcthorse\"}" }, "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 401', function () { pm.response.to.have.status(401); });", "pm.test('error=invalid_credentials', function () { pm.expect(pm.response.json().error).to.eql('invalid_credentials'); });"] } }]
        },
        {
          "name": "GET /auth/me (with access_token)",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', function () { pm.response.to.have.status(200); });", "var b = pm.response.json();", "pm.test('id is uuid', function () { pm.expect(b.id).to.match(/^[0-9a-f-]{36}$/); });", "pm.test('email matches', function () { pm.expect(b.email).to.eql(pm.environment.get('test_email')); });", "pm.test('role=user', function () { pm.expect(b.role).to.eql('user'); });"] } }]
        },
        {
          "name": "GET /auth/me no token -> 401",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 401', function () { pm.response.to.have.status(401); });", "pm.test('error=invalid_token', function () { pm.expect(pm.response.json().error).to.eql('invalid_token'); });"] } }]
        },
        {
          "name": "GET /auth/me bad bearer -> 401",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer not-a-jwt" }], "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 401', function () { pm.response.to.have.status(401); });", "pm.test('error=invalid_token', function () { pm.expect(pm.response.json().error).to.eql('invalid_token'); });"] } }]
        },        {
          "name": "POST /auth/refresh (rotate tokens)",
          "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', function () { pm.response.to.have.status(200); });", "var b = pm.response.json();", "pm.test('new access_token', function () { pm.expect(b.access_token).to.match(/^eyJ/); });", "pm.test('HttpOnly refresh cookie', function () { pm.expect(pm.response.headers.get('Set-Cookie')).to.contain('refresh_token='); pm.expect(pm.response.headers.get('Set-Cookie')).to.contain('HttpOnly'); });", "pm.environment.set('access_token', b.access_token);"] } }]
        },
        {
          "name": "POST /auth/refresh unknown -> 401",
          "request": { "method": "POST", "header": [{ "key": "Cookie", "value": "refresh_token=this-token-does-not-exist" }], "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 401', function () { pm.response.to.have.status(401); });", "pm.test('error=invalid_token', function () { pm.expect(pm.response.json().error).to.eql('invalid_token'); });"] } }]
        },
        {
          "name": "POST /auth/logout",
          "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 204', function () { pm.response.to.have.status(204); });", "pm.test('clears refresh cookie', function () { pm.expect(pm.response.headers.get('Set-Cookie')).to.contain('refresh_token='); pm.expect(pm.response.headers.get('Set-Cookie')).to.contain('Max-Age=0'); });"] } }]
        }
      ]
    },    {
      "name": "Users",
