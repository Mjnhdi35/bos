# BOS environment variables (template).
# Copy to `.env` and fill in real values. `.env` is gitignored.

# ─── Runtime ──────────────────────────────────────────────────
# Runtime environment. Affects logger format (pretty in development, JSON in production).
NODE_ENV=development
# HTTP server port (integer, positive, <= 65535). Defaults to 3000 if unset.
PORT=3001

# ─── Logging ──────────────────────────────────────────────────
# Pino log level. Options: trace, debug, info, warn, error, fatal, silent.
# Default: info. Use "debug" or "trace" only for local development.
LOG_LEVEL=info

# ─── PostgreSQL ───────────────────────────────────────────────
# DB host (default: localhost). For Docker Compose, use 127.0.0.1.
DB_HOST=127.0.0.1
# DB port (default: 5432).
DB_PORT=5432
# DB name (default: bos).
DB_NAME=bos
# DB user (default: bos).
DB_USER=bos
# DB password. Must match POSTGRES_PASSWORD in docker-compose.yml.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DB_PASSWORD=

# ─── pgAdmin ──────────────────────────────────────────────────
# pgAdmin web UI login. Used by docker-compose.yml.
PGADMIN_EMAIL=admin@bos.com
PGADMIN_DEFAULT_PASSWORD=admin

# ─── JWT (Identity module) ───────────────────────────────────
# Secret used to sign + verify access tokens (HS256).
# Must be at least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access token TTL. Format: <number><unit> where unit ∈ s,m,h,d. Default 15m.
JWT_ACCESS_TTL=15m
# Refresh token TTL. Default 30d.
JWT_REFRESH_TTL=30d

# ─── Persistence (Phase 5+) ──────────────────────────────────
# Runtime persistence backend. One of: inmemory | postgres | mysql.
DATABASE=inmemory

# ─── MySQL ────────────────────────────────────────────────────
# Optional second persistence backend. Used when DATABASE=mysql.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=bos
MYSQL_USER=bos
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
